# Copie para .env e ajuste. Em staging/prod (VPS, D-16) os valores ficam nas variáveis da Coolify.
APP_ENV=dev
PORT=3000
# Papel dono do schema (executa migrations)
DATABASE_ADMIN_URL=postgres://bm_owner:bm_owner@localhost:5432/bm
# Papel da aplicação (sujeito a RLS) — criado pela migration 0001
DATABASE_URL=postgres://bm_app:bm_app_dev@localhost:5432/bm
REDIS_URL=redis://localhost:6379
# Chave mestra (32 bytes base64, `openssl rand -base64 32`) para envelope encryption.
# Dev/test: LOCAL_MASTER_KEY. Staging/prod: MASTER_KEY (+ MASTER_KEY_ID), guardada também no cofre.
LOCAL_MASTER_KEY=
# Segredo base para HMAC de telefones (base64, 32+ bytes)
PHONE_HASH_PEPPER=
SESSION_COOKIE_SECURE=false
