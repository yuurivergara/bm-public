{
  "name": "bm-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate": "pnpm --filter @bm/db migrate",
    "dev:api": "pnpm --filter @bm/api dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.20.5",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  }
}
